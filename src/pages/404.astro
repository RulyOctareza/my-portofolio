---
import Base from '../layouts/Base.astro';
---

<Base lang="id" title="Halaman tidak ditemukan | Ruly Octareza" description="Halaman ini tidak ada. Page not found." noindex>
  <header class="site-header">
    <div class="wrap header__inner">
      <a class="wordmark" href="/">Ruly Octareza</a>
    </div>
  </header>
  <main id="main" class="notfound">
    <div class="wrap">
      <h1>Halaman tidak ditemukan</h1>
      <p class="notfound__en" lang="en">Page not found.</p>
      <p class="notfound__text">Alamatnya mungkin salah ketik, atau halamannya sudah dipindah.</p>
      <div class="notfound__actions">
        <a class="btn btn--primary" href="/">Kembali ke beranda</a>
        <a class="text-link" href="/#work">Lihat proyek live</a>
        <a class="text-link" href="/en/" hreflang="en" lang="en">Go to the English page</a>
      </div>
    </div>
  </main>
</Base>
