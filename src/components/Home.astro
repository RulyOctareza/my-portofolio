---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Phone from './Phone.astro';
import Browser from './Browser.astro';
import {
  ui,
  tr,
  wa,
  work,
  builtFor,
  services,
  labFeatured,
  labMore,
  journey,
  learning,
  stackGroups,
  GITHUB,
  REPO,
  type Lang,
} from '../data/site';

import phoneTransia from '../assets/phone/transia.jpg';
import phoneMasjid from '../assets/phone/masjidkorea.jpg';
import phoneAlishlah from '../assets/phone/alishlah.jpg';
import photo from '../assets/about/ruly.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = (v: { id: string; en: string }) => tr(v, lang);
const other: Lang = lang === 'id' ? 'en' : 'id';
const otherHref = other === 'en' ? '/en/' : '/';
const home = lang === 'id' ? '/' : '/en/';
const waMain = wa(t(ui.hero.waText));
const year = new Date().getFullYear();
const allStack = stackGroups.flatMap((g) => g.items);
const ext = { target: '_blank', rel: 'noopener' };
---

<a class="skip-link" href="#main">{t(ui.skip)}</a>

<header class="site-header">
  <div class="container header__inner">
    <a class="brand" href={home} aria-label="Ruly Octareza">
      <span class="brand__mark" aria-hidden="true">RO</span>
      <span class="brand__name">Ruly Octareza</span>
    </a>
    <nav id="site-nav" class="nav" aria-label={lang === 'id' ? 'Navigasi utama' : 'Main navigation'}>
      <a href="#work">{t(ui.nav.work)}</a>
      <a href="#services">{t(ui.nav.services)}</a>
      <a href="#lab">{t(ui.nav.lab)}</a>
      <a href="#journey">{t(ui.nav.journey)}</a>
      <a href="#contact">{t(ui.nav.contact)}</a>
    </nav>
    <div class="header__actions">
      <a class="lang-switch" href={otherHref} hreflang={other} lang={other} title={t(ui.nav.langLabel)}>
        <span class="sr-only">{t(ui.nav.langLabel)}</span><span aria-hidden="true">{other.toUpperCase()}</span>
      </a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label={t(ui.nav.theme)} title={t(ui.nav.theme)}>
        <Icon name="moon" class="i-moon" />
        <Icon name="sun" class="i-sun" />
      </button>
      <a class="btn btn--sm btn--primary header__cta" href={waMain} {...ext}>{t(ui.nav.cta)}</a>
      <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav" aria-label={t(ui.nav.menu)}>
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<main id="main">
  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="status"><span class="status__dot" aria-hidden="true"></span>{t(ui.hero.status)}</p>
        <h1 id="hero-title" class="hero__title">
          {t(ui.hero.titleA)} <span class="mark">{t(ui.hero.titleMark)}</span>{t(ui.hero.titleB)}
        </h1>
        <p class="hero__lead">{t(ui.hero.lead)}</p>
        <div class="hero__ctas">
          <a class="btn btn--primary btn--lg" href={waMain} {...ext}><Icon name="whatsapp" /> {t(ui.hero.ctaPrimary)}</a>
          <a class="btn btn--ghost btn--lg" href="#work">{t(ui.hero.ctaSecondary)} <Icon name="arrowDown" size={18} /></a>
        </div>
        <dl class="stats">
          {
            ui.hero.stats.map((s) => (
              <div class="stat">
                <dt>{t(s.l)}</dt>
                <dd>{s.n}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="hero__visual">
        <Phone class="phone--left" src={phoneTransia} alt={t(ui.hero.phoneAlt.transia)} />
        <Phone class="phone--center" src={phoneMasjid} alt={t(ui.hero.phoneAlt.masjid)} eager />
        <Phone class="phone--right" src={phoneAlishlah} alt={t(ui.hero.phoneAlt.alishlah)} />
        <span class="float-chip chip--a" aria-hidden="true"><i></i>{t(ui.hero.chips.a)}</span>
        <span class="float-chip chip--b" aria-hidden="true"><i></i>{t(ui.hero.chips.b)}</span>
        <span class="float-chip chip--c" aria-hidden="true"><i></i>{t(ui.hero.chips.c)}</span>
      </div>
    </div>

    <div class="container">
      <div class="builtfor" data-reveal>
        <span class="builtfor__label">{t(ui.builtFor)}</span>
        <ul class="builtfor__list">
          {builtFor.map((n) => <li>{n}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ WORK ============ -->
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <header class="section__head" data-reveal>
        <p class="kicker"><span>01</span>{t(ui.work.kicker)}</p>
        <h2 id="work-title">{t(ui.work.title)}</h2>
        <p class="section__sub">{t(ui.work.sub)}</p>
      </header>

      <div class="work-grid">
        {
          work.map((w, i) => (
            <article class:list={['work-card', `work-card--${w.span}`]} id={`work-${w.id}`} data-reveal style={`--d:${(i % 2) * 90}ms`}>
              <a class="work-card__media" href={w.links[0].href} {...ext} tabindex="-1" aria-hidden="true">
                <Browser
                  src={w.shot}
                  alt={t(w.shotAlt)}
                  url={w.url}
                  scroll={w.scroll}
                  sizes={w.span === 'wide' ? '(max-width: 900px) 92vw, 680px' : w.span === 'half' ? '(max-width: 900px) 92vw, 580px' : '(max-width: 900px) 92vw, 480px'}
                />
              </a>
              <div class="work-card__body">
                <div class="work-card__meta">
                  <span class="pill">{t(w.kind)}</span>
                  <span class="year">{w.year}</span>
                </div>
                <h3>
                  <a href={w.links[0].href} {...ext}>{w.title}</a>
                </h3>
                <p>{t(w.desc)}</p>
                <ul class="tags">
                  {w.stack.map((s) => <li>{s}</li>)}
                </ul>
                <div class="work-card__links">
                  {w.links.map((l) => (
                    <a class="link-btn" href={l.href} {...ext}>
                      <Icon name={l.kind === 'code' ? 'github' : 'arrowUpRight'} size={16} />
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="section section--alt" id="services" aria-labelledby="services-title">
    <div class="container">
      <header class="section__head" data-reveal>
        <p class="kicker"><span>02</span>{t(ui.services.kicker)}</p>
        <h2 id="services-title">{t(ui.services.title)}</h2>
        <p class="section__sub">{t(ui.services.sub)}</p>
      </header>

      <div class="services-grid">
        {
          services.map((s, i) => (
            <article class="service" data-reveal style={`--d:${(i % 2) * 90}ms`}>
              <div class="service__top">
                <span class="service__icon">
                  <Icon name={s.icon} size={26} />
                </span>
                <span class="service__num">0{i + 1}</span>
              </div>
              <h3>{t(s.title)}</h3>
              <p>{t(s.desc)}</p>
              <ul class="checks">
                {s.bullets.map((b) => (
                  <li>
                    <Icon name="check" size={18} />
                    {t(b)}
                  </li>
                ))}
              </ul>
              <div class="service__foot">
                <p class="proof">
                  <span>{t(ui.services.proof)}:</span>
                  {s.proof.map((p) => <a href={p.href}>{p.label}</a>)}
                </p>
                <a class="btn btn--sm btn--soft" href={wa(t(s.waText))} {...ext}>
                  {t(ui.services.cta)} <Icon name="arrowUpRight" size={16} />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ LAB ============ -->
  <section class="section" id="lab" aria-labelledby="lab-title">
    <div class="container">
      <header class="section__head" data-reveal>
        <p class="kicker"><span>03</span>{t(ui.lab.kicker)}</p>
        <h2 id="lab-title">{t(ui.lab.title)}</h2>
        <p class="section__sub">{t(ui.lab.sub)}</p>
      </header>

      <div class="lab-feature">
        {
          labFeatured.map((item, i) => (
            <article class="lab-card lab-card--shot" id={`lab-${item.id}`} data-reveal style={`--d:${i * 80}ms`}>
              {item.shot && (
                <a class="lab-card__media" href={item.live ?? item.code} {...ext} tabindex="-1" aria-hidden="true">
                  <Picture
                    src={item.shot}
                    alt={item.shotAlt ? t(item.shotAlt) : item.title}
                    formats={['avif', 'webp']}
                    widths={[400, 640, 800]}
                    sizes="(max-width: 620px) 92vw, (max-width: 960px) 46vw, 380px"
                  />
                </a>
              )}
              <div class="lab-card__body">
                <span class="lab-card__tag">{t(item.tag)}</span>
                <h3>{item.title}</h3>
                <p>{t(item.desc)}</p>
                <ul class="tags">
                  {item.stack.map((s) => <li>{s}</li>)}
                </ul>
                <div class="lab-card__links">
                  {item.live && (
                    <a class="link-btn" href={item.live} {...ext}>
                      <Icon name="arrowUpRight" size={16} />
                      {t(ui.common.live)}
                    </a>
                  )}
                  {item.code && (
                    <a class="link-btn" href={item.code} {...ext}>
                      <Icon name="github" size={16} />
                      {t(ui.common.code)}
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="lab-grid">
        {
          labMore.map((item, i) => (
            <article class="lab-card" id={`lab-${item.id}`} data-reveal style={`--d:${(i % 3) * 70}ms`}>
              <div class="lab-card__head">
                {item.icon && (
                  <span class="lab-card__icon">
                    <Icon name={item.icon} size={22} />
                  </span>
                )}
                <span class="lab-card__tag">{t(item.tag)}</span>
              </div>
              <h3>{item.title}</h3>
              <p>{t(item.desc)}</p>
              <ul class="tags">
                {item.stack.map((s) => <li>{s}</li>)}
              </ul>
              <div class="lab-card__links">
                {item.code ? (
                  <a class="link-btn" href={item.code} {...ext}>
                    <Icon name="github" size={16} />
                    {t(ui.common.code)}
                  </a>
                ) : (
                  <span class="link-btn link-btn--muted">
                    <Icon name="lock" size={15} />
                    {t(ui.common.private)}
                  </span>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ JOURNEY ============ -->
  <section class="section section--alt" id="journey" aria-labelledby="journey-title">
    <div class="container journey">
      <div class="journey__aside" data-reveal>
        <figure class="polaroid">
          <Picture
            src={photo}
            alt={t(ui.journey.photoAlt)}
            formats={['avif', 'webp']}
            widths={[320, 480, 720]}
            sizes="(max-width: 900px) 300px, 380px"
          />
          <figcaption>{t(ui.journey.caption)}</figcaption>
        </figure>
      </div>
      <div class="journey__main">
        <header class="section__head" data-reveal>
          <p class="kicker"><span>04</span>{t(ui.journey.kicker)}</p>
          <h2 id="journey-title">{t(ui.journey.title)}</h2>
          <p class="section__sub">{t(ui.journey.sub)}</p>
        </header>
        <ol class="timeline">
          {
            journey.map((j, i) => (
              <li data-reveal style={`--d:${i * 80}ms`}>
                <span class="timeline__when">{t(j.when)}</span>
                <h3>{t(j.role)}</h3>
                <p class="timeline__org">{t(j.org)}</p>
                <p class="timeline__desc">{t(j.desc)}</p>
              </li>
            ))
          }
        </ol>
        <div class="learning" data-reveal>
          <span>{t(ui.journey.learning)}</span>
          <ul>
            {learning.map((l) => <li>{l}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STACK ============ -->
  <section class="section section--stack" id="stack" aria-labelledby="stack-title">
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {[...allStack, ...allStack].map((s) => <span>{s}</span>)}
      </div>
    </div>
    <div class="container">
      <header class="section__head" data-reveal>
        <p class="kicker"><span>05</span>{t(ui.stack.kicker)}</p>
        <h2 id="stack-title">{t(ui.stack.title)}</h2>
      </header>
      <div class="stack-grid">
        {
          stackGroups.map((g, i) => (
            <div class="stack-group" data-reveal style={`--d:${i * 60}ms`}>
              <h3>{t(g.name)}</h3>
              <ul class="tags">
                {g.items.map((s) => <li>{s}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="section section--contact" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <div class="contact" data-reveal>
        <div class="contact__glow" aria-hidden="true"></div>
        <p class="kicker"><span>06</span>{t(ui.contact.kicker)}</p>
        <h2 id="contact-title">{t(ui.contact.title)}</h2>
        <p class="contact__sub">{t(ui.contact.sub)}</p>
        <div class="contact__actions">
          <a class="btn btn--primary btn--lg" href={waMain} {...ext}>
            <Icon name="whatsapp" />
            {t(ui.contact.wa)} <span class="btn__note">+62 813-1957-7004</span>
          </a>
          <a class="btn btn--glass btn--lg" href="#contact" data-email data-u="rulyoctareza" data-d="gmail.com">
            <Icon name="mail" />
            <span data-email-label>{t(ui.contact.email)}</span>
          </a>
          <a class="btn btn--glass btn--lg" href={GITHUB} {...ext}>
            <Icon name="github" />
            {t(ui.contact.github)}
          </a>
        </div>
        <noscript><p class="contact__meta">rulyoctareza [at] gmail.com</p></noscript>
        <p class="contact__meta"><Icon name="pin" size={18} />{t(ui.contact.location)}</p>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="container footer__inner">
    <p>© {year} Ruly Octareza. {t(ui.footer.made)}</p>
    <p>
      <a href={REPO} {...ext}>{t(ui.footer.source)}</a> · <a href={`${REPO}/tree/flutter-legacy`} {...ext}>{t(ui.footer.legacy)}</a>
    </p>
  </div>
</footer>

<script>
  const root = document.documentElement;

  // Reveal on scroll — hidden state only applies once this script runs.
  try {
    const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if ('IntersectionObserver' in window) {
      root.classList.add('reveal-ready');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -6% 0px', threshold: 0.06 },
      );
      els.forEach((el) => io.observe(el));
    }
  } catch {
    root.classList.remove('reveal-ready');
  }

  // Theme toggle (light / dark), remembered per browser.
  const prefersDark = () => window.matchMedia('(prefers-color-scheme: dark)').matches;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const current = root.getAttribute('data-theme') ?? (prefersDark() ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable: theme still applies for this visit */
    }
  });

  // Header border once the page scrolls.
  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu.
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');
  const setMenu = (open: boolean) => {
    menuBtn?.setAttribute('aria-expanded', String(open));
    nav?.toggleAttribute('data-open', open);
  };
  menuBtn?.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });

  // Email assembled in the browser to keep it away from simple scrapers.
  document.querySelectorAll<HTMLAnchorElement>('[data-email]').forEach((a) => {
    const { u, d } = a.dataset;
    if (!u || !d) return;
    const addr = `${u}@${d}`;
    a.href = `mailto:${addr}`;
    const label = a.querySelector('[data-email-label]');
    if (label) label.textContent = addr;
  });
</script>
