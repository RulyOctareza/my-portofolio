---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Phone from './Phone.astro';
import Shot from './Shot.astro';
import {
  ui,
  tr,
  wa,
  featured,
  projects,
  others,
  services,
  timeline,
  tools,
  GITHUB,
  REPO,
  WA_DISPLAY,
  type Lang,
  type L,
} from '../data/site';

import phoneTransia from '../assets/phone/transia.jpg';
import phoneMasjid from '../assets/phone/masjidkorea.jpg';
import photo from '../assets/about/ruly.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = (v: L) => tr(v, lang);
const other: Lang = lang === 'id' ? 'en' : 'id';
const otherHref = other === 'en' ? '/en/' : '/';
const home = lang === 'id' ? '/' : '/en/';
const waMain = wa(t(ui.hero.waText));
const liveCount = projects.length + 1; // featured + list, so the hero count follows the data
const year = new Date().getFullYear();
const ext = { target: '_blank', rel: 'noopener' };
---

<a class="skip-link" href="#main">{t(ui.skip)}</a>

<header class="site-header">
  <div class="wrap header__inner">
    <a class="wordmark" href={home}>Ruly Octareza</a>
    <nav id="site-nav" class="nav" aria-label={t(ui.nav.label)}>
      <ul>
        <li><a href="#work">{t(ui.nav.work)}</a></li>
        <li><a href="#services">{t(ui.nav.services)}</a></li>
        <li><a href="#about">{t(ui.nav.about)}</a></li>
        <li><a href="#contact">{t(ui.nav.contact)}</a></li>
      </ul>
    </nav>
    <div class="header__controls">
      <a class="ctrl ctrl--text" href={otherHref} hreflang={other} lang={other}>
        {other.toUpperCase()}<span class="sr-only"> ({t(ui.nav.langLabel)})</span>
      </a>
      <button class="ctrl" type="button" data-theme-toggle aria-pressed="false" aria-label={t(ui.nav.theme)}>
        <Icon name="moon" class="i-moon" />
        <Icon name="sun" class="i-sun" />
      </button>
      <button
        class="ctrl ctrl--text menu-btn"
        type="button"
        data-menu-toggle
        data-open-label={t(ui.nav.menu)}
        data-close-label={t(ui.nav.close)}
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span data-menu-label>{t(ui.nav.menu)}</span>
      </button>
    </div>
  </div>
</header>

<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <h1 id="hero-title">{t(ui.hero.title)}</h1>
        <p class="hero__lead">{t(ui.hero.lead)}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={waMain} {...ext}>
            <Icon name="whatsapp" />
            {t(ui.hero.ctaPrimary)}
          </a>
          <a class="text-link" href="#work">{t(ui.hero.ctaSecondary).replace('{n}', String(liveCount))}</a>
        </div>
      </div>
      <div class="hero__devices">
        <Phone src={phoneMasjid} alt={t(ui.hero.phoneAlt.masjid)} caption="masjidkorea.com" priority />
        <Phone src={phoneTransia} alt={t(ui.hero.phoneAlt.transia)} caption="transiacareer.id" />
      </div>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <header class="section__head">
        <h2 id="work-title">{t(ui.work.title)}</h2>
        <p class="section__sub">{t(ui.work.sub)}</p>
      </header>

      <article class="feature" id={`work-${featured.id}`} aria-labelledby={`title-${featured.id}`}>
        <Shot
          class="feature__shot"
          src={featured.shot}
          alt={t(featured.shotAlt)}
          sizes="(max-width: 899px) calc(100vw - 48px), (max-width: 1240px) 55vw, 620px"
        />
        <div class="project">
          <p class="project__meta">{t(featured.kind)} · {t(featured.when)}</p>
          <h3 id={`title-${featured.id}`}>{featured.title}</h3>
          <p class="project__desc">{t(featured.desc)}</p>
          <p class="project__stack">{featured.stack}</p>
          <ul class="links">
            <li><a class="domain" href={featured.domain.href} {...ext}>{featured.domain.label}</a></li>
            {
              featured.extra.map((l) => (
                <li>
                  <a href={l.href} {...ext}>
                    {t(l.label)}
                    <span class="sr-only"> ({featured.title})</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      <ul class="rows">
        {
          projects.map((p) => (
            <li class="row" id={`work-${p.id}`}>
              <div class="project">
                <p class="project__meta">
                  {t(p.kind)} · {t(p.when)}
                </p>
                <h3>{p.title}</h3>
                <p class="project__desc">{t(p.desc)}</p>
                <p class="project__stack">{p.stack}</p>
                <ul class="links">
                  <li>
                    <a class="domain" href={p.domain.href} {...ext}>
                      {p.domain.label}
                    </a>
                  </li>
                  {p.extra.map((l) => (
                    <li>
                      <a href={l.href} {...ext}>
                        {t(l.label)}
                        <span class="sr-only"> ({p.title})</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              <Shot
                class="row__shot"
                src={p.shot}
                alt={t(p.shotAlt)}
                sizes="(max-width: 759px) calc(100vw - 40px), (max-width: 1240px) 50vw, 580px"
              />
            </li>
          ))
        }
      </ul>

      <div class="others">
        <h3 class="others__title">{t(ui.work.othersTitle)}</h3>
        <p class="section__sub">{t(ui.work.othersSub)}</p>
        <ul class="others__list">
          {
            others.map((o) => (
              <li class="other" id={`other-${o.id}`}>
                <h4>{o.title}</h4>
                <p class="other__desc">{t(o.desc)}</p>
                <p class="other__stack">{o.stack}</p>
                <p class="other__links">
                  {o.privateRepo ? (
                    <span class="muted">{t(ui.work.private)}</span>
                  ) : (
                    o.links.map((l) => (
                      <a href={l.href} {...ext}>
                        {t(l.label)}
                        <span class="sr-only"> ({o.title})</span>
                      </a>
                    ))
                  )}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="wrap services">
      <header class="section__head services__head">
        <h2 id="services-title">{t(ui.services.title)}</h2>
        <p class="section__sub">{t(ui.services.sub)}</p>
      </header>
      <ul class="service-list">
        {
          services.map((s) => (
            <li class="service">
              <h3>{t(s.title)}</h3>
              <p class="service__desc">{t(s.desc)}</p>
              <div class="service__foot">
                <p class="examples">
                  {t(ui.services.example)}:{' '}
                  {s.examples.map((e, i) => (
                    <>
                      <a href={e.href}>{e.label}</a>
                      {i < s.examples.length - 1 ? ', ' : ''}
                    </>
                  ))}
                </p>
                <a class="btn btn--line" href={wa(t(s.waText))} {...ext}>
                  <Icon name="whatsapp" size={18} />
                  {t(s.cta)}
                  <span class="sr-only"> {t(ui.services.via)}</span>
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="wrap about">
      <div class="about__media">
        <Picture
          class="about__photo"
          src={photo}
          alt={t(ui.about.photoAlt)}
          formats={['avif', 'webp']}
          widths={[280, 420, 560, 760]}
          sizes="(max-width: 899px) 280px, 380px"
        />
      </div>
      <div class="about__body">
        <header class="section__head">
          <h2 id="about-title">{t(ui.about.title)}</h2>
          <p class="section__sub">{t(ui.about.sub)}</p>
        </header>
        <ol class="timeline">
          {
            timeline.map((item) => (
              <li>
                <p class="timeline__when">{t(item.when)}</p>
                <div>
                  <h3>{t(item.role)}</h3>
                  <p class="timeline__org">{t(item.org)}</p>
                  <p class="timeline__desc">{t(item.desc)}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="learning">{t(ui.about.learning)}</p>
      </div>
    </div>
  </section>

  <section class="section section--tools" id="tools" aria-labelledby="tools-title">
    <div class="wrap tools">
      <h2 id="tools-title">{t(ui.tools.title)}</h2>
      <dl class="tools-list">
        {
          tools.map((g) => (
            <div>
              <dt>{t(g.name)}</dt>
              <dd>{g.items}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <h2 id="contact-title">{t(ui.contact.title)}</h2>
      <p class="contact__sub">{t(ui.contact.sub)}</p>
      <div class="contact__actions">
        <a class="btn btn--primary" href={waMain} {...ext}>
          <Icon name="whatsapp" />
          WhatsApp <span class="btn__note">{WA_DISPLAY}</span>
        </a>
        <a class="btn btn--line" href="#contact" data-email data-u="rulyoctareza" data-d="gmail.com">
          <span data-email-label>{t(ui.contact.email)}</span>
        </a>
        <a class="btn btn--line" href={GITHUB} {...ext}>
          <Icon name="github" />
          GitHub
        </a>
      </div>
      <noscript><p class="contact__meta">rulyoctareza [at] gmail.com</p></noscript>
      <p class="contact__meta">{t(ui.contact.location)}</p>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="wrap footer__inner">
    <p>© {year} Ruly Octareza</p>
    <ul class="footer__links">
      <li><a href={REPO} {...ext}>{t(ui.footer.source)}</a></li>
      <li><a href={`${REPO}/tree/flutter-legacy`} {...ext}>{t(ui.footer.legacy)}</a></li>
    </ul>
  </div>
</footer>

<script>
  const root = document.documentElement;

  // Theme: light/dark toggle, remembered per browser when storage is available.
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.getAttribute('data-theme') ?? (darkQuery.matches ? 'dark' : 'light')) === 'dark';
  const syncToggle = () => {
    toggle?.setAttribute('aria-pressed', String(isDark()));
    // Keep the mobile browser bar in step with a manually chosen theme.
    if (root.hasAttribute('data-theme')) {
      document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => {
        m.content = isDark() ? '#111413' : '#f7f5f0';
      });
    }
  };
  syncToggle();
  darkQuery.addEventListener('change', syncToggle);
  toggle?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage blocked: the theme still applies for this visit */
    }
    syncToggle();
  });

  // Mobile menu: labelled button, closes on link click and on Escape (focus returns to the button).
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');
  const menuLabel = menuBtn?.querySelector('[data-menu-label]');
  const setMenu = (open: boolean, returnFocus = false) => {
    if (!menuBtn || !nav) return;
    menuBtn.setAttribute('aria-expanded', String(open));
    nav.toggleAttribute('data-open', open);
    if (menuLabel) menuLabel.textContent = (open ? menuBtn.dataset.closeLabel : menuBtn.dataset.openLabel) ?? '';
    if (!open && returnFocus) menuBtn.focus();
  };
  menuBtn?.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') setMenu(false, true);
  });

  // Email address assembled in the browser to keep it away from simple scrapers.
  document.querySelectorAll<HTMLAnchorElement>('[data-email]').forEach((a) => {
    const { u, d } = a.dataset;
    if (!u || !d) return;
    const address = `${u}@${d}`;
    a.href = `mailto:${address}`;
    const label = a.querySelector('[data-email-label]');
    if (label) label.textContent = address;
  });
</script>
